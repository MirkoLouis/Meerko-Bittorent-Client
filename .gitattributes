# Normalize all text files to LF in the repository and working tree
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets are never converted
*.ico binary
*.png binary
*.exe binary

# Armored GPG keys and signatures are plain text
*.asc text eol=lf
