#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# AppImage entry point: `cli` as the first argument runs meerko-bittorent-cli, anything else opens the GUI

# The AppImage runtime sets APPDIR; fall back to this script's directory for extracted runs
if [ -z "${APPDIR:-}" ]; then
    APPDIR="$(dirname "$(readlink -f "$0")")"
fi
binary_directory="$APPDIR/usr/lib/meerko-bittorent"

# Command-line mode: drop the `cli` word and pass the rest through
if [ "${1:-}" = "cli" ]; then
    shift
    exec "$binary_directory/meerko-bittorent-cli" "$@"
fi

exec "$binary_directory/meerko-bittorent" "$@"
